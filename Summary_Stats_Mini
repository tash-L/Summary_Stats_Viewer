                    """Check if series is numeric or can be converted to numeric"""
                    if pd.api.types.is_numeric_dtype(series):
                        return True, series
                    
                    # Try to convert to numeric
                    try:
                        numeric_series = pd.to_numeric(series, errors='coerce')
                        non_null_original = series.notna().sum()
                        if non_null_original == 0:
                            return False, series
                        non_null_converted = numeric_series.notna().sum()
                        # If more than 80% can be converted, treat as numeric
                        if (non_null_converted / non_null_original) >= 0.8:
                            return True, numeric_series
                        return False, series
                    except:
                        return False, series
                
