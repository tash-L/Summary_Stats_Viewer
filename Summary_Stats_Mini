            #define enhanced function to remove outliers
            def remove_outliers_zscore(df_outliers, column, threshold=3):
                """Enhanced outlier removal that handles string-to-numeric conversion"""
                series = df_outliers[column]
                
                # Convert to numeric if needed
                if not pd.api.types.is_numeric_dtype(series):
                    numeric_series = pd.to_numeric(series, errors='coerce')
                    # Create a mask for valid numeric values
                    valid_mask = ~numeric_series.isna()
                else:
                    numeric_series = series
                    valid_mask = ~series.isna()
                
                if valid_mask.sum() == 0:
                    return df_outliers  # No valid numeric data
                
                # Calculate z-score only for valid numeric values
                mean_val = numeric_series[valid_mask].mean()
                std_val = numeric_series[valid_mask].std()
                
                if std_val == 0:
                    return df_outliers  # No variation in data
                
                z_scores = abs((numeric_series - mean_val) / std_val)
                
                # Keep rows where z-score is acceptable OR where original data was non-numeric
                keep_mask = (z_scores < threshold) | ~valid_mask
                
                return df_outliers[keep_mask]
            
            #Remove outliers if requested
