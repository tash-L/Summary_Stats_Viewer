#Function to display options in alphabetical grid format
def display_options_grid(options, title="Options", columns=3):
    """
    Display options in alphabetical order in a grid format
    Returns: (sorted_options, original_to_sorted_mapping)
    """
    print(f"\n{title}:")
    
    # Create sorted list with original indices
    indexed_options = [(i, option) for i, option in enumerate(options)]
    sorted_indexed = sorted(indexed_options, key=lambda x: x[1].lower())
    
    # Create mapping from new display number to original index
    display_to_original = {}
    
    # Display in grid format
    for i, (original_idx, option) in enumerate(sorted_indexed):
        display_num = i + 1
        display_to_original[display_num] = original_idx
        
        # Format option with number and pad for alignment
        option_str = f"{display_num:2d}. {option}"
        
        # Print in columns
        if (i + 1) % columns == 0 or i == len(sorted_indexed) - 1:
            print(option_str)
        else:
            print(f"{option_str:<35}", end="  ")
    
    return display_to_original

