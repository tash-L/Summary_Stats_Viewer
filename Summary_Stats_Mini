    #Function definitions
    #Function to check if a column can be converted to numeric
    def is_potentially_numeric(series):
        """
        Check if a series can be converted to numeric, even if it's currently stored as object/string
        Returns True if column is numeric or can be converted with >80% success rate
        """
        if pd.api.types.is_numeric_dtype(series):
            return True
        
        # Try to convert to numeric and see if we get mostly valid numbers
        try:
            numeric_series = pd.to_numeric(series, errors='coerce')
            # If more than 80% of non-null values are numeric, consider it numeric
            non_null_count = series.notna().sum()
            if non_null_count == 0:
                return False
            numeric_count = numeric_series.notna().sum()
            return (numeric_count / non_null_count) >= 0.8
        except:
            return False

    def normalize_missing_tokens(series):
        """Coerce common string placeholders for missing values to actual NA"""
        if not (pd.api.types.is_object_dtype(series) or pd.api.types.is_string_dtype(series)):
            return series
        series_copy = series.copy()
        string_mask = series_copy.map(lambda x: isinstance(x, str))
        if not string_mask.any():
            return series_copy
        normalized_strings = series_copy[string_mask].str.strip().str.lower()
        missing_tokens = {
            "", "nan", "na", "n/a", "n.a.", "missing", "missing date", "unknown",
            "not known", "none", "null", "not available", "not applicable", "-", "--",
            "nill", "nil"
        }
        replace_mask = normalized_strings.isin(missing_tokens)
        if replace_mask.any():
            series_copy.loc[replace_mask[replace_mask].index] = pd.NA
        return series_copy

    #Function to check if a column contains datetime data
    def is_datetime_variable(series):
        #Check if a series contains datetime data or can be converted to datetime
        #Returns dictionary with datetime info
        
        from datetime import datetime
        
        # If already datetime dtype, return True immediately
        if pd.api.types.is_datetime64_any_dtype(series):
            return {
                "is_datetime": True, 
                "datetime_format": "already_datetime",
                "success_rate": 1.0,
                "date_range": (series.min(), series.max())
            }
        
        series_clean = normalize_missing_tokens(series)
        non_null_series = series_clean[series_clean.notna()]
        if len(non_null_series) == 0:
            return {"is_datetime": False}
        
        # Pre-filter: Check if this could be numeric data first
        # If it's potentially numeric, don't treat as datetime
        if is_potentially_numeric(series_clean):
            return {"is_datetime": False}
        
        # Additional pre-filters to avoid false positives
        sample_values = non_null_series.head(10).astype(str)
        
        # Skip if values look like pure numbers (including decimals)
        numeric_pattern_count = 0
        for val in sample_values:
            val_clean = str(val).strip()
            # Check if it's just a number (integer or float)
            try:
                float(val_clean)
                numeric_pattern_count += 1
            except:
                pass
        
        # If most sample values are pure numbers, probably not datetime
        if numeric_pattern_count >= len(sample_values) * 0.8:
            return {"is_datetime": False}
        
        # Check for datetime-like patterns in the strings
        datetime_indicators = 0
        for val in sample_values:
            val_str = str(val).strip()
            # Look for datetime separators and patterns
            if any(sep in val_str for sep in ['-', '/', ':', ' ']):
                # Additional checks for common datetime patterns
                if (len(val_str) >= 6 and  # Minimum reasonable date length
                    any(pattern in val_str.lower() for pattern in ['jan', 'feb', 'mar', 'apr', 'may', 'jun',
                                                                   'jul', 'aug', 'sep', 'oct', 'nov', 'dec']) or
                    ('/' in val_str and len(val_str.split('/')) in [2, 3]) or
                    ('-' in val_str and len(val_str.split('-')) in [2, 3]) or
                    (':' in val_str)):  # Time component
                    datetime_indicators += 1
        
        # If no datetime-like patterns found, skip datetime detection
        if datetime_indicators == 0:
            return {"is_datetime": False}

        # Extra heuristic: ISO-like date strings even with mixed content
        if len(non_null_series) >= 5:
            string_values = non_null_series.astype(str).str.strip()
            iso_like = string_values.str.match(r'^\d{4}[-/]\d{2}[-/]\d{2}$')
            if iso_like.sum() >= 5:
                iso_conversion = pd.to_datetime(series_clean, errors='coerce')
                valid_iso = iso_conversion.notna().sum()
                if valid_iso >= 5:
                    return {
                        "is_datetime": True,
                        "datetime_format": "iso_inferred",
                        "success_rate": valid_iso / max(series_clean.notna().sum(), 1),
                        "date_range": (iso_conversion.min(), iso_conversion.max()),
                        "converted_series": iso_conversion
                    }
        
        # Common datetime formats to try
        datetime_formats = [
            '%Y-%m-%d',           # 2023-01-15
            '%d/%m/%Y',           # 15/01/2023
            '%m/%d/%Y',           # 01/15/2023
            '%Y-%m-%d %H:%M:%S',  # 2023-01-15 14:30:25
            '%d/%m/%Y %H:%M',     # 15/01/2023 14:30
            '%m/%d/%Y %H:%M',     # 01/15/2023 14:30
            '%Y%m%d',             # 20230115
            '%d-%m-%Y',           # 15-01-2023
            '%m-%d-%Y',           # 01-15-2023
            '%Y/%m/%d',           # 2023/01/15
            '%d.%m.%Y',           # 15.01.2023
            '%b %d, %Y',          # Jan 15, 2023
            '%B %d, %Y',          # January 15, 2023
            '%d %b %Y',           # 15 Jan 2023
            '%d %B %Y',           # 15 January 2023
        ]
        
        best_success_rate = 0
        best_format = None
        successful_conversions = None
        
        # Try pandas' flexible datetime parser first (with warning suppression)
        try:
            import warnings
            with warnings.catch_warnings():
                warnings.simplefilter("ignore", UserWarning)
                test_conversion = pd.to_datetime(series_clean, errors='coerce')
            
            non_null_count = series_clean.notna().sum()
            success_count = test_conversion.notna().sum()
            success_rate = success_count / non_null_count if non_null_count > 0 else 0
            
            # Check if conversion was successful (allow lower rate if enough valid dates exist)
            if success_rate >= 0.6 or (success_count >= 5 and success_rate >= 0.3):
                valid_dates = test_conversion[test_conversion.notna()]
                if len(valid_dates) > 0:
                    min_year = valid_dates.min().year
                    max_year = valid_dates.max().year
                    # Check if dates are in a reasonable range (allow any year, just check max is not too far future)
                    if max_year <= 2100:
                        min_date = test_conversion.min()
                        max_date = test_conversion.max()
                        return {
                            "is_datetime": True,
                            "datetime_format": "auto_detected",
                            "success_rate": success_rate,
                            "date_range": (min_date, max_date),
                            "converted_series": test_conversion
                        }
        except:
            pass
        
        # Try specific formats if auto-detection didn't work well enough
        for fmt in datetime_formats:
            try:
                import warnings
                with warnings.catch_warnings():
                    warnings.simplefilter("ignore", UserWarning)
                    test_conversion = pd.to_datetime(series_clean, format=fmt, errors='coerce')
                
                non_null_count = series_clean.notna().sum()
                success_count = test_conversion.notna().sum()
                success_rate = success_count / non_null_count if non_null_count > 0 else 0
                
                if success_rate > best_success_rate:
                    best_success_rate = success_rate
                    best_format = fmt
                    successful_conversions = test_conversion
                    
                if success_rate >= 0.6 or (success_count >= 5 and success_rate >= 0.3):  # Accept if enough valid dates
                    # Additional validation: check date range reasonableness
                    valid_dates = test_conversion[test_conversion.notna()]
                    if len(valid_dates) > 0:
                        min_year = valid_dates.min().year
                        max_year = valid_dates.max().year
                        if max_year <= 2100:
                            min_date = test_conversion.min()
                            max_date = test_conversion.max()
                            return {
                                "is_datetime": True,
                                "datetime_format": fmt,
                                "success_rate": success_rate,
                                "date_range": (min_date, max_date),
                                "converted_series": test_conversion
                            }
            except:
                continue
        
        # If we found a reasonable conversion but not perfect, still consider it datetime
        if best_success_rate >= 0.6 or (best_success_rate >= 0.3 and successful_conversions is not None and successful_conversions.notna().sum() >= 5):  # Lower threshold for edge cases when enough valid dates exist
            # Final validation: check date range reasonableness
            valid_dates = successful_conversions[successful_conversions.notna()]
            if len(valid_dates) > 0:
                min_year = valid_dates.min().year
                max_year = valid_dates.max().year
                if max_year <= 2100:
                    min_date = successful_conversions.min()
                    max_date = successful_conversions.max()
                    return {
                        "is_datetime": True,
                        "datetime_format": best_format,
                        "success_rate": best_success_rate,
                        "date_range": (min_date, max_date),
                        "converted_series": successful_conversions
                    }
        
        return {"is_datetime": False}

    #Enhanced variable type detection with datetime support
    def detect_variable_type(series):
        """
        Detect if variable is datetime, binary, categorical, or other type
        Returns: (type_name, additional_info)
        """
        # Ensure we're working with a Series, not a DataFrame
        if isinstance(series, pd.DataFrame):
            # If it's a DataFrame, take the first (and should be only) column
            series = series.iloc[:, 0]
        
        series_clean = normalize_missing_tokens(series)
        non_null_series = series_clean[series_clean.notna()]
        if len(non_null_series) == 0:
            return "empty", {}
        
        # Ensure unique_count is a scalar value - use len(unique()) for reliability
        unique_count = len(non_null_series.unique())
        
        # Datetime detection - check first as strings might be datetime
        datetime_info = is_datetime_variable(series_clean)
        if datetime_info["is_datetime"]:
            return "datetime", datetime_info
        
        # Special handling for small number of unique values that might be coded categories
        # Check if this looks like coded categorical data before checking if it's numeric
        if unique_count <= 10:  # Small number of unique values
            
            # Binary detection (exactly 2 unique values) - prioritize over numeric
            if unique_count == 2:
                values = list(non_null_series.unique())
                values_lower = [str(v).lower() for v in values]
                
                # Check for common binary patterns (including numeric codes)
                binary_patterns = [
                    {"yes", "no"}, {"y", "n"}, {"true", "false"},
                    {"male", "female"}, {"m", "f"}, {"1", "0"},
                    {"1.0", "0.0"}, {"true", "false"}, {"positive", "negative"}
                ]
                
                pattern_found = "custom"
                for pattern in binary_patterns:
                    if set(values_lower) == pattern:
                        pattern_found = "/".join(sorted(pattern))
                        break
                
                # Special check for 0/1 or 1/2 type coding
                if set(values_lower) in [{"0", "1"}, {"1", "2"}, {"0.0", "1.0"}, {"1.0", "2.0"}]:
                    pattern_found = "numeric_binary_coded"
                
                return "binary", {"values": values, "pattern": pattern_found}
            
            # Categorical with few categories (likely coded) - check before numeric
            elif unique_count <= 10:
                # Check if all values look like simple category codes
                try:
                    numeric_values = [float(str(v)) for v in non_null_series.unique()]
                    # If they're all simple integers in a small range, likely categorical codes
                    if all(v == int(v) for v in numeric_values) and max(numeric_values) - min(numeric_values) < 20:
                        return "categorical_coded", {"unique_count": unique_count, "values": sorted(non_null_series.unique())}
                except:
                    pass
                
                return "categorical", {"unique_count": unique_count}
        
        # For variables with many unique values, check if it's potentially numeric
        if is_potentially_numeric(series):
            return "numeric", {"is_numeric": True}
        
        # Continue with regular categorical detection
        
        # Binary detection (exactly 2 unique values)
        if unique_count == 2:
            values = list(non_null_series.unique())
            values_lower = [str(v).lower() for v in values]
            
            # Check for common binary patterns
            binary_patterns = [
                {"yes", "no"}, {"y", "n"}, {"true", "false"},
                {"male", "female"}, {"m", "f"}, {"1", "0"}
            ]
            
            pattern_found = "custom"
            for pattern in binary_patterns:
                if set(values_lower) == pattern:
                    pattern_found = "/".join(sorted(pattern))
                    break
            
            return "binary", {"values": values, "pattern": pattern_found}
        
        # Categorical detection (reasonable number of categories)
        elif unique_count <= 20:
            return "categorical", {"unique_count": unique_count}
        
        # High cardinality
        else:
            cardinality_pct = (unique_count / len(non_null_series)) * 100
            if cardinality_pct > 95:
                return "identifier", {"unique_count": unique_count, "cardinality_pct": cardinality_pct}
            else:
                return "high_cardinality", {"unique_count": unique_count, "cardinality_pct": cardinality_pct}
    
    #Binary variable visualization
    def visualize_binary_variable(series, column_name):
        """Create appropriate visualization for binary variables"""
        counts = series.value_counts(dropna=False)
        total_non_null = series.notna().sum()
        
        # Print counts with percentages
        print(f"\nBinary counts for '{column_name}':")
        for value, count in counts.items():
            if pd.isna(value):
                pct = (count / len(series)) * 100
                print(f"  Missing: {count} ({pct:.1f}%)")
            else:
                pct = (count / total_non_null) * 100 if total_non_null > 0 else 0
                print(f"  {value}: {count} ({pct:.1f}%)")
        
        # Create visualizations
        non_null_counts = series.value_counts(dropna=True)
        colors = ['lightcoral', 'lightskyblue']
        
        # Pie chart
        plt.figure(figsize=(6, 5))
        plt.pie(non_null_counts.values, labels=non_null_counts.index, 
               autopct='%1.1f%%', colors=colors, startangle=90)
        plt.title(f"Distribution of {column_name} (Binary)")
        plt.axis('equal')
        plt.show()
        
        # Bar chart with counts
        plt.figure(figsize=(6, 4))
        ax = non_null_counts.plot(kind='bar', color=colors)
        plt.title(f"Counts for {column_name} (Binary)")
        plt.xlabel("Values")
        plt.ylabel("Count")
        plt.xticks(rotation=0)
        
        # Add count labels on bars
        for i, v in enumerate(non_null_counts.values):
            ax.text(i, v + max(non_null_counts.values) * 0.01, str(v), 
                    ha='center', va='bottom')
        
        plt.tight_layout()
        plt.show()
    
    #Categorical variable visualization
    def visualize_categorical_variable(series, column_name, unique_count, top_n=10):
        """Create appropriate visualization for categorical variables"""
        counts = series.value_counts(dropna=False)
        total_non_null = series.notna().sum()
        
        # Print summary
        print(f"\nCategorical summary for '{column_name}':")
        print(f"  Total categories: {unique_count}")
        print(f"  Most common: {counts.index[0]} ({counts.iloc[0]})" if len(counts) > 0 else "  No data")
        
        # Show top categories
        display_n = min(top_n, len(counts))
        print(f"\nTop {display_n} categories:")
        
        for i, (value, count) in enumerate(counts.head(display_n).items()):
            if pd.isna(value):
                pct = (count / len(series)) * 100
                print(f"  {i+1}. Missing: {count} ({pct:.1f}%)")
            else:
                pct = (count / total_non_null) * 100 if total_non_null > 0 else 0
                display_value = str(value)[:25] + "..." if len(str(value)) > 25 else str(value)
                print(f"  {i+1}. {display_value}: {count} ({pct:.1f}%)")
        
        if len(counts) > display_n:
            print(f"  ... and {len(counts) - display_n} other categories")
        
        # Create bar chart
        plt.figure(figsize=(max(8, min(unique_count * 0.8, 12)), 5))
        top_counts = counts.head(display_n)
        ax = top_counts.plot(kind='bar', color='lightgreen')
        
        title = f"Top {display_n} Categories in {column_name}" if len(counts) > display_n else f"Distribution of {column_name}"
        plt.title(title)
        plt.xlabel("Categories")
        plt.ylabel("Count")
        plt.xticks(rotation=45, ha='right')
        
        # Add count labels on bars
        for i, v in enumerate(top_counts.values):
            ax.text(i, v + max(top_counts.values) * 0.01, str(v), 
                    ha='center', va='bottom', fontsize=9)
        
        plt.tight_layout()
        plt.show()

    #Datetime variable visualization
    def visualize_datetime_variable(series, column_name, datetime_info):
        """Create appropriate visualization for datetime variables"""
        # Convert to datetime if needed
        if 'converted_series' in datetime_info:
            dt_series = datetime_info['converted_series']
        else:
            dt_series = pd.to_datetime(series, errors='coerce')
        
        # For visualization we need valid dates, but we preserve information about missing values
        dt_valid = dt_series[dt_series.notna()]
        
        if len(dt_valid) == 0:
            print(f"\nNo valid datetime values found for '{column_name}'")
            return
        
        # Print datetime summary
        print(f"\nDatetime summary for '{column_name}':")
        print(f"  Date format detected: {datetime_info.get('datetime_format', 'unknown')}")
        print(f"  Conversion success rate: {datetime_info.get('success_rate', 0):.1%}")
        print(f"  Valid dates: {len(dt_valid)}")
        print(f"  Missing values: {len(series) - len(dt_valid)}")
        print(f"  Date range: {dt_valid.min().strftime('%Y-%m-%d')} to {dt_valid.max().strftime('%Y-%m-%d')}")
        
        # Calculate time span
        time_span = dt_valid.max() - dt_valid.min()
        print(f"  Time span: {time_span.days} days ({time_span.days/365.25:.1f} years)")
        
        # Create visualizations based on time span and data density
        if time_span.days > 365:  # More than a year
            # Time series plot with monthly/yearly aggregation
            plt.figure(figsize=(12, 6))
            
            # Create frequency plot
            dt_valid_sorted = dt_valid.sort_values()
            
            # Subplot 1: Timeline distribution
            plt.subplot(2, 1, 1)
            plt.hist(dt_valid_sorted, bins=min(50, len(dt_valid)//10 + 1), alpha=0.7, color='skyblue', edgecolor='black')
            plt.title(f"Distribution of {column_name} Over Time")
            plt.xlabel("Date")
            plt.ylabel("Frequency")
            plt.xticks(rotation=45)
            
            # Subplot 2: Cumulative timeline
            plt.subplot(2, 1, 2)
            cumulative_counts = range(1, len(dt_valid_sorted) + 1)
            plt.plot(dt_valid_sorted, cumulative_counts, color='red', linewidth=2)
            plt.title(f"Cumulative Timeline for {column_name}")
            plt.xlabel("Date")
            plt.ylabel("Cumulative Count")
            plt.xticks(rotation=45)
            
        else:  # Less than a year
            # Detailed timeline with daily/weekly resolution
            plt.figure(figsize=(12, 4))
            plt.hist(dt_valid, bins=min(30, len(dt_valid)//5 + 1), alpha=0.7, color='lightgreen', edgecolor='black')
            plt.title(f"Distribution of {column_name} (Detailed Timeline)")
            plt.xlabel("Date")
            plt.ylabel("Frequency")
            plt.xticks(rotation=45)
        
        plt.tight_layout()
        plt.show()
        
        # Additional analysis for patterns
        if len(dt_valid) > 10:  # Only if we have enough data
